<Window x:Class="GCam.UI.Diagnostics.ErrorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="G-CAM"
        SizeToContent="Height"
        Width="560"
        MinHeight="160"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="White">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Summary: the only thing most users need to read. -->
        <TextBlock x:Name="SummaryText"
                   Grid.Row="0"
                   TextWrapping="Wrap"
                   FontSize="14"
                   Foreground="#37475A" />

        <!-- Collapsed by default so an expected-failure message is not buried under
             a stack trace. Hidden entirely for GCamUserException. -->
        <Expander x:Name="DetailsExpander"
                  Grid.Row="1"
                  Header="Details"
                  Margin="0,14,0,0">
            <Border BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    Margin="0,6,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto"
                              MaxHeight="260">
                    <TextBox x:Name="DetailsText"
                             IsReadOnly="True"
                             BorderThickness="0"
                             Background="#FAFAFA"
                             FontFamily="Consolas"
                             FontSize="11"
                             Padding="8"
                             TextWrapping="NoWrap" />
                </ScrollViewer>
            </Border>
        </Expander>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button x:Name="CopyButton"
                    Content="Copy details"
                    Width="104"
                    Height="26"
                    Margin="0,0,8,0"
                    Click="OnCopyClick" />
            <Button x:Name="LogFolderButton"
                    Content="Open log folder"
                    Width="116"
                    Height="26"
                    Margin="0,0,8,0"
                    Click="OnOpenLogFolderClick" />
            <Button Content="OK"
                    Width="80"
                    Height="26"
                    IsDefault="True"
                    IsCancel="True"
                    Click="OnCloseClick" />
        </StackPanel>
    </Grid>
</Window>
