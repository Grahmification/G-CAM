<Window x:Class="GCam.UI.Views.ToolEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:GCam.UI.Controls"
        xmlns:views="clr-namespace:GCam.UI.Views"
        Title="{Binding Title}"
        Height="560" Width="760"
        MinHeight="480" MinWidth="680"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F5F6F7">

    <Window.Resources>
        <views:ToolTypeNameConverter x:Key="ToolTypeName" />
        <views:BoolToVisibilityConverter x:Key="BoolToVisibility" />

        <Style TargetType="TextBlock" x:Key="FieldLabel">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <Style TargetType="TextBox" x:Key="FieldBox">
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="Padding" Value="3,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="ComboBox" x:Key="FieldCombo">
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- Two columns: label, then field. Reused by every tab. -->
        <Style TargetType="Grid" x:Key="FieldGrid">
            <Setter Property="Margin" Value="14" />
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="380" />
            <ColumnDefinition Width="230" MinWidth="160" />
        </Grid.ColumnDefinitions>

        <TabControl Grid.Row="0" Grid.Column="0" Margin="0,0,8,0">

            <!-- ── General ──────────────────────────────────────────────── -->
            <TabItem Header="General">
                <Grid Style="{StaticResource FieldGrid}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Type" Style="{StaticResource FieldLabel}" />
                    <ComboBox Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldCombo}"
                              ItemsSource="{Binding ToolTypes}"
                              SelectedItem="{Binding Type}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource ToolTypeName}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Description" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldBox}"
                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Tool number" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldBox}"
                             Text="{Binding Number, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Material" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource FieldBox}"
                             Text="{Binding Material, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Manufacturer" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource FieldBox}"
                             Text="{Binding Manufacturer, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Product ID" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="5" Grid.Column="1" Style="{StaticResource FieldBox}"
                             Text="{Binding ProductId, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Comment" Style="{StaticResource FieldLabel}"
                               VerticalAlignment="Top" Margin="0,6,8,0" />
                    <TextBox Grid.Row="6" Grid.Column="1" Style="{StaticResource FieldBox}"
                             Height="64" TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalContentAlignment="Top"
                             Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </TabItem>

            <!-- ── Cutter ───────────────────────────────────────────────── -->
            <TabItem Header="Cutter">
                <Grid Style="{StaticResource FieldGrid}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Diameter" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldBox}"
                             Text="{Binding Diameter, UpdateSourceTrigger=PropertyChanged, StringFormat=0.###}" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="mm" Style="{StaticResource FieldLabel}" Margin="6,0,0,0" />

                    <TextBlock Grid.Row="1" Text="Corner radius" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldBox}"
                             Text="{Binding CornerRadius, UpdateSourceTrigger=PropertyChanged, StringFormat=0.###}" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="mm" Style="{StaticResource FieldLabel}" Margin="6,0,0,0" />

                    <TextBlock Grid.Row="2" Text="Tip angle (included)" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldBox}"
                             Text="{Binding TipAngle, UpdateSourceTrigger=PropertyChanged, StringFormat=0.###}" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="°" Style="{StaticResource FieldLabel}" Margin="6,0,0,0" />

                    <TextBlock Grid.Row="3" Text="Second tip angle" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource FieldBox}"
                             Text="{Binding SecondTipAngle, UpdateSourceTrigger=PropertyChanged, StringFormat=0.###}" />
                    <TextBlock Grid.Row="3" Grid.Column="2" Text="°" Style="{StaticResource FieldLabel}" Margin="6,0,0,0" />

                    <TextBlock Grid.Row="4" Text="Tip diameter" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource FieldBox}"
                             Text="{Binding TipDiameter, UpdateSourceTrigger=PropertyChanged, StringFormat=0.###}" />
                    <TextBlock Grid.Row="4" Grid.Column="2" Text="mm" Style="{StaticResource FieldLabel}" Margin="6,0,0,0" />

                    <TextBlock Grid.Row="5" Text="Flute length" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="5" Grid.Column="1" Style="{StaticResource FieldBox}"
                             Text="{Binding FluteLength, UpdateSourceTrigger=PropertyChanged, StringFormat=0.###}" />
                    <TextBlock Grid.Row="5" Grid.Column="2" Text="mm" Style="{StaticResource FieldLabel}" Margin="6,0,0,0" />

                    <TextBlock Grid.Row="6" Text="Number of flutes" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="6" Grid.Column="1" Style="{StaticResource FieldBox}"
                             Text="{Binding FluteCount, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="7" Text="Thread pitch" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="7" Grid.Column="1" Style="{StaticResource FieldBox}"
                             Text="{Binding ThreadPitch, UpdateSourceTrigger=PropertyChanged, StringFormat=0.###}" />
                    <TextBlock Grid.Row="7" Grid.Column="2" Text="mm" Style="{StaticResource FieldLabel}" Margin="6,0,0,0" />
                </Grid>
            </TabItem>

            <!-- ── Shank ────────────────────────────────────────────────── -->
            <TabItem Header="Shank">
                <Grid Style="{StaticResource FieldGrid}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Shoulder length" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldBox}"
                             Text="{Binding ShoulderLength, UpdateSourceTrigger=PropertyChanged, StringFormat=0.###}" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="mm" Style="{StaticResource FieldLabel}" Margin="6,0,0,0" />

                    <TextBlock Grid.Row="1" Text="Shank diameter" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldBox}"
                             Text="{Binding ShankDiameter, UpdateSourceTrigger=PropertyChanged, StringFormat=0.###}" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="mm" Style="{StaticResource FieldLabel}" Margin="6,0,0,0" />

                    <TextBlock Grid.Row="2" Text="Body length" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldBox}"
                             Text="{Binding BodyLength, UpdateSourceTrigger=PropertyChanged, StringFormat=0.###}" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="mm" Style="{StaticResource FieldLabel}" Margin="6,0,0,0" />

                    <TextBlock Grid.Row="3" Text="Overall length" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource FieldBox}"
                             Text="{Binding OverallLength, UpdateSourceTrigger=PropertyChanged, StringFormat=0.###}" />
                    <TextBlock Grid.Row="3" Grid.Column="2" Text="mm" Style="{StaticResource FieldLabel}" Margin="6,0,0,0" />

                    <TextBlock Grid.Row="4" Grid.ColumnSpan="3" Margin="0,10,0,0" TextWrapping="Wrap"
                               Foreground="#7A8690"
                               Text="Body length is how far the tool protrudes from the holder. The rest of the overall length is gripped." />
                </Grid>
            </TabItem>

            <!-- ── Holder ───────────────────────────────────────────────── -->
            <TabItem Header="Holder">
                <Grid Style="{StaticResource FieldGrid}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Holder" Style="{StaticResource FieldLabel}" />
                    <ComboBox Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldCombo}"
                              ItemsSource="{Binding Holders}"
                              SelectedItem="{Binding Holder}"
                              DisplayMemberPath="Name" />

                    <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" Foreground="#5A6570"
                               Text="{Binding HolderSummary}" />

                    <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Margin="0,16,0,0" TextWrapping="Wrap"
                               Foreground="#7A8690"
                               Text="Holders are shared by every tool that uses them, so their geometry is not editable here. Holders come from the library, usually imported alongside the tools." />
                </Grid>
            </TabItem>

            <!-- ── Feeds and speeds ─────────────────────────────────────── -->
            <TabItem Header="Feeds &amp; Speeds">
                <Grid Style="{StaticResource FieldGrid}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Spindle speed" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldBox}"
                             Text="{Binding SpindleRpm, UpdateSourceTrigger=PropertyChanged, StringFormat=0.##}" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="rpm" Style="{StaticResource FieldLabel}" Margin="6,0,0,0" />

                    <TextBlock Grid.Row="1" Text="Direction" Style="{StaticResource FieldLabel}" />
                    <CheckBox Grid.Row="1" Grid.Column="1" Margin="0,6" Content="Clockwise (M3)"
                              IsChecked="{Binding SpindleClockwise}" VerticalAlignment="Center" />

                    <TextBlock Grid.Row="2" Text="Feed mode" Style="{StaticResource FieldLabel}" />
                    <ComboBox Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldCombo}"
                              ItemsSource="{Binding FeedModes}" SelectedItem="{Binding FeedMode}" />

                    <TextBlock Grid.Row="3" Text="Coolant" Style="{StaticResource FieldLabel}" />
                    <ComboBox Grid.Row="3" Grid.Column="1" Style="{StaticResource FieldCombo}"
                              ItemsSource="{Binding CoolantModes}" SelectedItem="{Binding Coolant}" />

                    <TextBlock Grid.Row="4" Text="Cutting feed" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource FieldBox}"
                             Text="{Binding CuttingFeed, UpdateSourceTrigger=PropertyChanged, StringFormat=0.##}" />
                    <TextBlock Grid.Row="4" Grid.Column="2" Text="mm/min" Style="{StaticResource FieldLabel}" Margin="6,0,0,0" />

                    <TextBlock Grid.Row="5" Text="Plunge feed" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="5" Grid.Column="1" Style="{StaticResource FieldBox}"
                             Text="{Binding PlungeFeed, UpdateSourceTrigger=PropertyChanged, StringFormat=0.##}" />
                    <TextBlock Grid.Row="5" Grid.Column="2" Text="mm/min" Style="{StaticResource FieldLabel}" Margin="6,0,0,0" />

                    <TextBlock Grid.Row="6" Text="Ramp feed" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="6" Grid.Column="1" Style="{StaticResource FieldBox}"
                             Text="{Binding RampFeed, UpdateSourceTrigger=PropertyChanged, StringFormat=0.##}" />
                    <TextBlock Grid.Row="6" Grid.Column="2" Text="mm/min" Style="{StaticResource FieldLabel}" Margin="6,0,0,0" />

                    <TextBlock Grid.Row="7" Text="Retract feed" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="7" Grid.Column="1" Style="{StaticResource FieldBox}"
                             Text="{Binding RetractFeed, UpdateSourceTrigger=PropertyChanged, StringFormat=0.##}" />
                    <TextBlock Grid.Row="7" Grid.Column="2" Text="mm/min" Style="{StaticResource FieldLabel}" Margin="6,0,0,0" />

                    <TextBlock Grid.Row="8" Text="Stepover / stepdown" Style="{StaticResource FieldLabel}" />
                    <Grid Grid.Row="8" Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Style="{StaticResource FieldBox}" Margin="0,3,4,3"
                                 Text="{Binding Stepover, UpdateSourceTrigger=PropertyChanged, StringFormat=0.###}" />
                        <TextBox Grid.Column="1" Style="{StaticResource FieldBox}" Margin="4,3,0,3"
                                 Text="{Binding Stepdown, UpdateSourceTrigger=PropertyChanged, StringFormat=0.###}" />
                    </Grid>
                    <TextBlock Grid.Row="8" Grid.Column="2" Text="mm" Style="{StaticResource FieldLabel}" Margin="6,0,0,0" />

                    <TextBlock Grid.Row="9" Text="Feed per tooth" Style="{StaticResource FieldLabel}" />
                    <TextBlock Grid.Row="9" Grid.Column="1" Margin="0,6" VerticalAlignment="Center"
                               Foreground="#5A6570" Text="{Binding FeedPerTooth}" />
                </Grid>
            </TabItem>

            <!-- ── Machine ──────────────────────────────────────────────── -->
            <TabItem Header="Machine">
                <Grid Style="{StaticResource FieldGrid}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Diameter offset (D)" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldBox}"
                             Text="{Binding DiameterOffset, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="1" Text="Length offset (H)" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldBox}"
                             Text="{Binding LengthOffset, UpdateSourceTrigger=PropertyChanged}" />

                    <CheckBox Grid.Row="2" Grid.Column="1" Margin="0,8,0,2" Content="Break control"
                              IsChecked="{Binding BreakControl}" />
                    <CheckBox Grid.Row="3" Grid.Column="1" Margin="0,2" Content="Manual tool change"
                              IsChecked="{Binding ManualToolChange}" />

                    <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Margin="0,16,0,0" TextWrapping="Wrap"
                               Foreground="#7A8690"
                               Text="Posted code refers to control registers, not dimensions: G43 H&lt;length offset&gt; and G41/G42 D&lt;diameter offset&gt;. These usually match the tool number, but not always." />
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ── Live preview ─────────────────────────────────────────────── -->
        <Border Grid.Row="0" Grid.Column="1" BorderBrush="#D0D4D8" BorderThickness="1" Background="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#F0F2F4" BorderBrush="#D0D4D8" BorderThickness="0,0,0,1">
                    <Grid Margin="8,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Preview" FontWeight="SemiBold" Foreground="#37475A"
                                   VerticalAlignment="Center" />
                        <CheckBox x:Name="EditorShowHolder" Grid.Column="1" Content="Holder" IsChecked="True"
                                  VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <controls:ToolProfileView Grid.Row="1" Tool="{Binding PreviewTool}"
                                          ShowHolder="{Binding IsChecked, ElementName=EditorShowHolder}"
                                          ClipToBounds="True" />
            </Grid>
        </Border>

        <!-- ── Validation messages ──────────────────────────────────────── -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0" Padding="8,5"
                Background="#FDF3F2" BorderBrush="#E6C9C6" BorderThickness="1"
                Visibility="{Binding HasMessages, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding MessageText}" TextWrapping="Wrap" Foreground="#8A3A32" />
        </Border>

        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="OK" Width="88" Height="26" Margin="0,0,8,0" IsDefault="True"
                    Click="OnOk" IsEnabled="{Binding IsValid}" />
            <!-- IsCancel alone: it sets DialogResult false and closes. Adding a Click
                 handler that does the same makes two close attempts out of one click. -->
            <Button Content="Cancel" Width="88" Height="26" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
