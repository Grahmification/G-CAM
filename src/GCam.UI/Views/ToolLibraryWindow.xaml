<Window x:Class="GCam.UI.Views.ToolLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="G-CAM Tool Library"
        Height="520" Width="820"
        WindowStartupLocation="CenterOwner"
        Background="White">

    <!--
        Popup viewer/editor for the external tool library XML. Empty for now;
        the real window binds a DataGrid of tools to GCam.Core's IToolLibrary.
    -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Tool library"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="#37475A" />

        <Border Grid.Row="1"
                Margin="0,12"
                BorderBrush="#DDDDDD"
                BorderThickness="1">
            <TextBlock Text="No library loaded."
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="#888888" />
        </Border>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Close"
                    Width="88"
                    Height="26"
                    IsCancel="True"
                    Click="OnCloseClick" />
        </StackPanel>
    </Grid>
</Window>
