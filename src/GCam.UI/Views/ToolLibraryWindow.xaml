<Window x:Class="GCam.UI.Views.ToolLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:GCam.UI.Controls"
        xmlns:vm="clr-namespace:GCam.UI.ViewModels"
        xmlns:views="clr-namespace:GCam.UI.Views"
        Title="G-CAM Tool Library"
        Height="620" Width="1000"
        MinHeight="420" MinWidth="720"
        WindowStartupLocation="CenterOwner"
        Background="#F5F6F7">

    <Window.Resources>
        <views:ToolTypeNameConverter x:Key="ToolTypeName" />

        <!-- Folders and library files share one tree, so the template is chosen by type. -->
        <HierarchicalDataTemplate DataType="{x:Type vm:FolderNode}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Margin="0,1">
                <TextBlock Text="📁" Margin="0,0,5,0" />
                <TextBlock Text="{Binding Name}" />
                <TextBlock Text=" (missing)" Foreground="#C0392B" FontStyle="Italic">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </HierarchicalDataTemplate>

        <DataTemplate DataType="{x:Type vm:LibraryFileNode}">
            <StackPanel Orientation="Horizontal" Margin="0,1">
                <TextBlock Text="🔧" Margin="0,0,5,0" />
                <TextBlock Text="{Binding Name}" />
                <Border Background="#E4E8EC" CornerRadius="2" Margin="6,0,0,0" Padding="3,0">
                    <TextBlock Text="{Binding Format}" FontSize="9" Foreground="#5A6570" />
                </Border>
            </StackPanel>
        </DataTemplate>

        <!-- Keeps tree selection in step with the viewmodel in both directions. -->
        <Style x:Key="TreeItemStyle" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
        </Style>

        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="MinWidth" Value="80" />
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" MinWidth="200" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="320" />
        </Grid.ColumnDefinitions>

        <!-- ── Folder toolbar ─────────────────────────────────────────── -->
        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,6">
            <Button Content="Add folder…" Style="{StaticResource ToolbarButton}" Click="OnAddFolder" />
            <Button x:Name="RemoveFolderButton" Content="Remove" Style="{StaticResource ToolbarButton}"
                    Click="OnRemoveFolder" MinWidth="66" />
            <Button Content="Refresh" Style="{StaticResource ToolbarButton}" Click="OnRefresh" MinWidth="66" />
        </StackPanel>

        <!-- ── Search ─────────────────────────────────────────────────── -->
        <Grid Grid.Row="0" Grid.Column="2" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Search:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox Grid.Column="1" VerticalContentAlignment="Center" Padding="4,3"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}" />
        </Grid>

        <!-- ── Left column: tree over profile preview ─────────────────── -->
        <Grid Grid.Row="1" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="120" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="200" MinHeight="120" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="#D0D4D8" BorderThickness="1" Background="White">
                <TreeView x:Name="FolderTree"
                          ItemsSource="{Binding Folders}"
                          ItemContainerStyle="{StaticResource TreeItemStyle}"
                          BorderThickness="0"
                          SelectedItemChanged="OnTreeSelectionChanged" />
            </Border>

            <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch"
                          Background="Transparent" ResizeBehavior="PreviousAndNext" />

            <Border Grid.Row="2" BorderBrush="#D0D4D8" BorderThickness="1" Background="White">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#F0F2F4" BorderBrush="#D0D4D8" BorderThickness="0,0,0,1">
                        <Grid Margin="8,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="{Binding SelectedTool.Name, TargetNullValue='Profile', FallbackValue='Profile'}"
                                       FontWeight="SemiBold" Foreground="#37475A"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />

                            <!-- A 90mm holder beside a 3mm cutter leaves the cutter a few
                                 pixels tall, so this needs to be switchable. -->
                            <CheckBox x:Name="ShowHolderCheck" Grid.Column="1" Content="Holder"
                                      IsChecked="True" VerticalAlignment="Center" Margin="8,0,0,0"
                                      ToolTip="Include the tool holder in the preview" />
                        </Grid>
                    </Border>

                    <controls:ToolProfileView Grid.Row="1"
                                              Tool="{Binding SelectedTool}"
                                              ShowHolder="{Binding IsChecked, ElementName=ShowHolderCheck}"
                                              ClipToBounds="True" />
                </Grid>
            </Border>
        </Grid>

        <GridSplitter Grid.Row="1" Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                      Background="Transparent" ResizeBehavior="PreviousAndNext" />

        <!-- ── Tool list ──────────────────────────────────────────────── -->
        <Border Grid.Row="1" Grid.Column="2" BorderBrush="#D0D4D8" BorderThickness="1" Background="White">
            <ListView x:Name="ToolList"
                      ItemsSource="{Binding Tools}"
                      SelectedItem="{Binding SelectedTool, Mode=TwoWay}"
                      BorderThickness="0"
                      MouseDoubleClick="OnToolDoubleClick">
                <ListView.View>
                    <GridView ColumnHeaderContainerStyle="{StaticResource {x:Type GridViewColumnHeader}}">
                        <GridViewColumn Header="Tool" Width="200"
                                        DisplayMemberBinding="{Binding DisplayName}" />
                        <GridViewColumn Header="T#" Width="42"
                                        DisplayMemberBinding="{Binding Number}" />
                        <GridViewColumn Header="Description" Width="170"
                                        DisplayMemberBinding="{Binding Name}" />
                        <GridViewColumn Header="Type" Width="120"
                                        DisplayMemberBinding="{Binding Type, Converter={StaticResource ToolTypeName}}" />
                        <GridViewColumn Header="Ø" Width="62"
                                        DisplayMemberBinding="{Binding Geometry.Diameter, StringFormat=F2}" />
                        <GridViewColumn Header="Corner R" Width="68"
                                        DisplayMemberBinding="{Binding Geometry.CornerRadius, StringFormat=F2}" />
                        <GridViewColumn Header="Flutes" Width="52"
                                        DisplayMemberBinding="{Binding Geometry.FluteCount}" />
                        <GridViewColumn Header="Flute len" Width="68"
                                        DisplayMemberBinding="{Binding Geometry.FluteLength, StringFormat=F2}" />
                        <GridViewColumn Header="Holder" Width="150"
                                        DisplayMemberBinding="{Binding Holder.Name}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <!-- ── Status strip and close ─────────────────────────────────── -->
        <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{Binding Status}" VerticalAlignment="Center"
                       Foreground="#5A6570" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="1" Text="{Binding ToolCountSummary}" VerticalAlignment="Center"
                       Foreground="#8A939C" Margin="12,0" />
            <Button Grid.Column="2" Content="Close" Width="86" Height="26"
                    IsCancel="True" Click="OnClose" />
        </Grid>
    </Grid>
</Window>
