<UserControl x:Class="GCam.UI.Views.JobTreeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:GCam.UI.ViewModels"
             xmlns:views="clr-namespace:GCam.UI.Views"
             Background="White">

    <!--
        The jobs / operations tree shown in the G-CAM tab of the SOLIDWORKS Manager
        Pane. Bound to a JobTreeViewModel pushed in by JobTreeTabs after SOLIDWORKS has
        activated the hosting control - this view keeps a parameterless constructor
        because COM creates it.
    -->

    <UserControl.Resources>
        <views:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <views:BoolToVisibilityConverter x:Key="NotToVisibility" Invert="True" />

        <!--
            Expansion is round-tripped through the node so the viewmodel can drive it, and
            so is WPF's own single selection - as IsCurrent, which is where the keyboard is
            rather than what is selected. Selecting a freshly duplicated job still works
            through it; the same arrangement as the tool library browser's folder tree.

            The several-rows selection that G-CAM actually shows is the node's IsSelected,
            drawn by the row template below. The built-in highlight is turned off here
            rather than left to fight with it: a TreeView highlights exactly one row, and
            two blues disagreeing about what is selected is worse than one.
        -->
        <Style x:Key="TreeItemStyle" TargetType="TreeViewItem">
            <Style.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"
                                 Color="Transparent" />
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"
                                 Color="{x:Static SystemColors.ControlTextColor}" />
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"
                                 Color="Transparent" />
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}"
                                 Color="{x:Static SystemColors.ControlTextColor}" />
            </Style.Resources>
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="IsSelected" Value="{Binding IsCurrent, Mode=TwoWay}" />
            <EventSetter Event="Loaded" Handler="OnRowLoaded" />
            <EventSetter Event="PreviewMouseRightButtonDown" Handler="OnNodeRightClick" />
            <EventSetter Event="PreviewMouseRightButtonUp" Handler="OnNodeRightButtonUp" />
            <EventSetter Event="MouseDoubleClick" Handler="OnNodeDoubleClick" />
            <Style.Triggers>
                <!--
                    A row with no arrow takes back the column the arrow would have sat in:
                    19px, which is the MinWidth TreeViewItem's own template gives that
                    column. Everything below the row moves with it, because a child row is
                    laid out inside its parent, so this is one level of indentation off the
                    whole tree rather than a nudge to one row.

                    The hidden expander is what ends up in the negative space, which is why
                    this is tied to there being no arrow: doing it to a row that has one
                    would push that arrow out of sight.
                -->
                <DataTrigger Binding="{Binding CanCollapse}" Value="False">
                    <Setter Property="Margin" Value="-19,0,0,0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--
            The state badge: a small disc in the corner of an operation's glyph, red when
            there is no toolpath to trust and amber when there is one worth reading about.
            A job never carries one, so the default is Collapsed and only the triggers
            below turn it on.

            Drawn as vector geometry rather than an emoji for the reason
            ToolTypeIconConverter gives: crisp at any DPI, and the colour is ours to
            choose rather than the font's. The white stroke around the disc is what keeps
            it legible against the gear behind it.
        -->
        <Style x:Key="BadgeDisc" TargetType="Ellipse">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Stroke" Value="White" />
            <Setter Property="StrokeThickness" Value="1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Badge}" Value="Error">
                    <Setter Property="Visibility" Value="Visible" />
                    <Setter Property="Fill" Value="#D0342C" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Badge}" Value="Warning">
                    <Setter Property="Visibility" Value="Visible" />
                    <Setter Property="Fill" Value="#E8A317" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--
            The mark inside the disc, in a nominal 9x9 box. Round caps are what let the
            exclamation mark's dot be a zero-length segment rather than a second shape.
        -->
        <Style x:Key="BadgeMark" TargetType="Path">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Stroke" Value="White" />
            <Setter Property="StrokeThickness" Value="1.4" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Badge}" Value="Error">
                    <Setter Property="Visibility" Value="Visible" />
                    <Setter Property="Data" Value="M 3,3 L 6,6 M 6,3 L 3,6" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Badge}" Value="Warning">
                    <Setter Property="Visibility" Value="Visible" />
                    <Setter Property="Data" Value="M 4.5,2.3 L 4.5,5.1 M 4.5,6.9 L 4.5,6.9" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--
            The selection highlight, drawn by the row rather than by the TreeView because
            several rows can carry it at once. Explorer's colours, so a G-CAM selection
            looks like a selection and not like a state badge.
        -->
        <Style x:Key="RowHighlight" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Padding" Value="3,1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="#CCE8FF" />
                    <Setter Property="BorderBrush" Value="#99D1FF" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--
            The insertion line a drag follows. Two styles rather than one plus a converter,
            matching the badge above: what is drawn is decided by the node's own state.
        -->
        <!--
            The base carries no trigger of its own on purpose: BasedOn *adds* triggers to
            the ones it inherits, so a shared trigger here would light both lines at once.
        -->
        <Style x:Key="DropLine" TargetType="Rectangle">
            <Setter Property="Height" Value="2" />
            <Setter Property="Fill" Value="#2A6FB0" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>

        <Style x:Key="DropLineAbove" TargetType="Rectangle" BasedOn="{StaticResource DropLine}">
            <Setter Property="VerticalAlignment" Value="Top" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Drop}" Value="Above">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DropLineBelow" TargetType="Rectangle" BasedOn="{StaticResource DropLine}">
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Drop}" Value="Below">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The label, which becomes a text box while the node is being renamed. -->
        <DataTemplate x:Key="NodeLabel">
            <Border Style="{StaticResource RowHighlight}">
                <Grid Margin="0,1" ToolTip="{Binding StatusText}">
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding IsEditing, Converter={StaticResource NotToVisibility}}">
                        <!--
                            The glyph and its badge share one cell, so the badge sits over the
                            gear's bottom-right corner and the row's layout is unchanged.
                        -->
                        <Grid Margin="0,0,5,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Glyph}" />
                            <Grid Width="9" Height="9" Margin="0,0,-2,-1"
                                  HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                <Ellipse Style="{StaticResource BadgeDisc}" />
                                <Path Style="{StaticResource BadgeMark}" />
                            </Grid>
                        </Grid>
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>

                                        <!--
                                            A suppressed operation is skipped by generation,
                                            not drawn and never posted. Without something to
                                            see here, suppressing one looks like its toolpath
                                            vanishing for no reason.
                                        -->
                                        <DataTrigger Binding="{Binding IsSuppressed}" Value="True">
                                            <Setter Property="Foreground" Value="#9AA4AE" />
                                            <Setter Property="FontStyle" Value="Italic" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Border Background="#E4E8EC" CornerRadius="2" Margin="6,0,0,0" Padding="4,0"
                                VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="default" FontSize="10" Foreground="#5A6570" />
                        </Border>
                    </StackPanel>

                    <!--
                        Where a dragged row would land. Overlaid on the label rather than
                        laid out above or below it, so the rows do not shift by two pixels
                        as the line follows the cursor.
                    -->
                    <Rectangle Style="{StaticResource DropLineAbove}" />
                    <Rectangle Style="{StaticResource DropLineBelow}" />

                    <TextBox x:Name="RenameBox"
                             Text="{Binding Name, Mode=OneWay}"
                             Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}"
                             MinWidth="90"
                             Padding="1,0"
                             KeyDown="OnRenameKeyDown"
                             LostKeyboardFocus="OnRenameLostFocus"
                             IsVisibleChanged="OnRenameBoxVisibleChanged" />
                </Grid>
            </Border>
        </DataTemplate>

        <!--
            The part, and every job in it. One template each rather than one for all three,
            because an operation has no children to hand an ItemsSource.
        -->
        <HierarchicalDataTemplate DataType="{x:Type vm:PartNode}"
                                  ItemsSource="{Binding Children}">
            <ContentPresenter ContentTemplate="{StaticResource NodeLabel}" Content="{Binding}" />
        </HierarchicalDataTemplate>

        <HierarchicalDataTemplate DataType="{x:Type vm:JobNode}"
                                  ItemsSource="{Binding Children}">
            <ContentPresenter ContentTemplate="{StaticResource NodeLabel}" Content="{Binding}" />
        </HierarchicalDataTemplate>

        <DataTemplate DataType="{x:Type vm:OperationNode}">
            <ContentPresenter ContentTemplate="{StaticResource NodeLabel}" Content="{Binding}" />
        </DataTemplate>
    </UserControl.Resources>

    <!--
        No heading above the tree: the part row at the top of it says which part these
        belong to, and says it for a part with no jobs as well - which is what the old
        "No job in this document." message was for, except that this one can be
        right-clicked to make the first one.
    -->
    <Grid>
        <TreeView x:Name="JobTree"
                  ItemsSource="{Binding Nodes}"
                  ItemContainerStyle="{StaticResource TreeItemStyle}"
                  BorderThickness="0"
                  Background="Transparent"
                  Margin="4,6,4,4"
                  AllowDrop="True"
                  PreviewMouseLeftButtonDown="OnNodeLeftClick"
                  PreviewMouseMove="OnTreeMouseMove"
                  DragOver="OnTreeDragOver"
                  DragLeave="OnTreeDragLeave"
                  Drop="OnTreeDrop"
                  SelectedItemChanged="OnTreeSelectionChanged"
                  KeyDown="OnTreeKeyDown" />
    </Grid>
</UserControl>
