<UserControl x:Class="GCam.UI.Views.JobTreeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:GCam.UI.ViewModels"
             xmlns:views="clr-namespace:GCam.UI.Views"
             Background="White">

    <!--
        The jobs / operations tree shown in the G-CAM tab of the SOLIDWORKS Manager
        Pane. Bound to a JobTreeViewModel pushed in by JobTreeTabs after SOLIDWORKS has
        activated the hosting control - this view keeps a parameterless constructor
        because COM creates it.
    -->

    <UserControl.Resources>
        <views:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <views:BoolToVisibilityConverter x:Key="NotToVisibility" Invert="True" />

        <!--
            Selection and expansion are round-tripped through the node so the viewmodel
            can drive them - selecting a freshly duplicated job, for instance. Same
            arrangement as the tool library browser's folder tree.
        -->
        <Style x:Key="TreeItemStyle" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <EventSetter Event="PreviewMouseRightButtonDown" Handler="OnNodeRightClick" />
            <EventSetter Event="PreviewMouseRightButtonUp" Handler="OnNodeRightButtonUp" />
            <EventSetter Event="MouseDoubleClick" Handler="OnNodeDoubleClick" />
        </Style>

        <!--
            The state badge: a small disc in the corner of an operation's glyph, red when
            there is no toolpath to trust and amber when there is one worth reading about.
            A job never carries one, so the default is Collapsed and only the triggers
            below turn it on.

            Drawn as vector geometry rather than an emoji for the reason
            ToolTypeIconConverter gives: crisp at any DPI, and the colour is ours to
            choose rather than the font's. The white stroke around the disc is what keeps
            it legible against the gear behind it.
        -->
        <Style x:Key="BadgeDisc" TargetType="Ellipse">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Stroke" Value="White" />
            <Setter Property="StrokeThickness" Value="1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Badge}" Value="Error">
                    <Setter Property="Visibility" Value="Visible" />
                    <Setter Property="Fill" Value="#D0342C" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Badge}" Value="Warning">
                    <Setter Property="Visibility" Value="Visible" />
                    <Setter Property="Fill" Value="#E8A317" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--
            The mark inside the disc, in a nominal 9x9 box. Round caps are what let the
            exclamation mark's dot be a zero-length segment rather than a second shape.
        -->
        <Style x:Key="BadgeMark" TargetType="Path">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Stroke" Value="White" />
            <Setter Property="StrokeThickness" Value="1.4" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Badge}" Value="Error">
                    <Setter Property="Visibility" Value="Visible" />
                    <Setter Property="Data" Value="M 3,3 L 6,6 M 6,3 L 3,6" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Badge}" Value="Warning">
                    <Setter Property="Visibility" Value="Visible" />
                    <Setter Property="Data" Value="M 4.5,2.3 L 4.5,5.1 M 4.5,6.9 L 4.5,6.9" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The label, which becomes a text box while the node is being renamed. -->
        <DataTemplate x:Key="NodeLabel">
            <Grid Margin="0,1" ToolTip="{Binding StatusText}">
                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding IsEditing, Converter={StaticResource NotToVisibility}}">
                    <!--
                        The glyph and its badge share one cell, so the badge sits over the
                        gear's bottom-right corner and the row's layout is unchanged.
                    -->
                    <Grid Margin="0,0,5,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Glyph}" />
                        <Grid Width="9" Height="9" Margin="0,0,-2,-1"
                              HorizontalAlignment="Right" VerticalAlignment="Bottom">
                            <Ellipse Style="{StaticResource BadgeDisc}" />
                            <Path Style="{StaticResource BadgeMark}" />
                        </Grid>
                    </Grid>
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>

                                    <!--
                                        A suppressed operation is skipped by generation,
                                        not drawn and never posted. Without something to
                                        see here, suppressing one looks like its toolpath
                                        vanishing for no reason.
                                    -->
                                    <DataTrigger Binding="{Binding IsSuppressed}" Value="True">
                                        <Setter Property="Foreground" Value="#9AA4AE" />
                                        <Setter Property="FontStyle" Value="Italic" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Border Background="#E4E8EC" CornerRadius="2" Margin="6,0,0,0" Padding="4,0"
                            VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="default" FontSize="10" Foreground="#5A6570" />
                    </Border>
                </StackPanel>

                <TextBox x:Name="RenameBox"
                         Text="{Binding Name, Mode=OneWay}"
                         Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}"
                         MinWidth="90"
                         Padding="1,0"
                         KeyDown="OnRenameKeyDown"
                         LostKeyboardFocus="OnRenameLostFocus"
                         IsVisibleChanged="OnRenameBoxVisibleChanged" />
            </Grid>
        </DataTemplate>

        <HierarchicalDataTemplate DataType="{x:Type vm:JobNode}"
                                  ItemsSource="{Binding Children}">
            <ContentPresenter ContentTemplate="{StaticResource NodeLabel}" Content="{Binding}" />
        </HierarchicalDataTemplate>

        <DataTemplate DataType="{x:Type vm:OperationNode}">
            <ContentPresenter ContentTemplate="{StaticResource NodeLabel}" Content="{Binding}" />
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="G-CAM jobs"
                   Margin="12,10,12,6"
                   FontWeight="SemiBold"
                   Foreground="#37475A" />

        <TextBlock Grid.Row="1"
                   Text="{Binding EmptyMessage}"
                   Margin="12,0,12,12"
                   VerticalAlignment="Top"
                   TextWrapping="Wrap"
                   Foreground="#888888"
                   Visibility="{Binding HasJobs, Converter={StaticResource NotToVisibility}}" />

        <TreeView Grid.Row="1"
                  x:Name="JobTree"
                  ItemsSource="{Binding Nodes}"
                  ItemContainerStyle="{StaticResource TreeItemStyle}"
                  BorderThickness="0"
                  Background="Transparent"
                  Visibility="{Binding HasJobs, Converter={StaticResource BoolToVisibility}}"
                  SelectedItemChanged="OnTreeSelectionChanged"
                  KeyDown="OnTreeKeyDown" />
    </Grid>
</UserControl>
